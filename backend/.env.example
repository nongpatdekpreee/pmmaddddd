# Database (see config/database.js)
# DB_HOST=xxxxxxxx
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db

# JWT — ตั้งค่าใน production (อย่า commit ค่าจริง)
JWT_SECRET=

# Access token TTL (jsonwebtoken format, e.g. 15m, 1h)
ACCESS_TOKEN_TTL=15m

# Refresh token (HttpOnly cookie)
REFRESH_TOKEN_COOKIE_NAME=refreshToken
# Session length — 1 day = 24 hours; หมดแล้วต้อง login ใหม่
REFRESH_TOKEN_TTL_DAYS=1
COOKIE_SECURE=false
# ส่ง cookie ได้แม้ใช้ HTTP (http://localhost) — เหมาะ dev
COOKIE_SAME_SITE=lax
# กฎ browser ว่า cookie ส่งไป request อื่นโดเมนได้แค่ไหน
# lax = ปกติพอสำหรับ frontend :3000 + backend :5000 (ผ่าน proxy)

# Microsoft Teams — แจ้งเตือนเมื่อสร้าง/แก้ไขสัญญา หรือสร้าง PM/MA plan
TEAMS_WEBHOOK_PROJECT_OWEN_SNS=

# Microsoft Teams — สรุป PM/MA plan ที่ใกล้ถึง (cron จันทร์ 09:00)
TEAMS_WEBHOOK_SNS_UPCOMING_PLANS=

# Microsoft Teams — สัญญาใกล้หมดอายุ (cron ทุกวัน 09:00) — ว่าง = ใช้ TEAMS_WEBHOOK_PROJECT_OWEN_SNS
TEAMS_WEBHOOK_CONTRACT_EXPIRING=

# Microsoft Teams — TCC (ว่าง = ไม่ส่งไปช่อง TCC)
TEAMS_WEBHOOK_TCC=
TEAMS_WEBHOOK_TCC_UPCOMING_PLANS=
TEAMS_WEBHOOK_TCC_CONTRACT_EXPIRING=

# แจ้งสัญญาใกล้หมด: cron ทุกวัน 09:00 + ทันทีเมื่อแก้สัญญา (ถ้าอยู่ในช่วงวันนี้ถึง +N วัน)
CONTRACT_EXPIRING_DAYS=90

# Cron: timezone และเปิด/ปิด (false = ปิด)
CRON_TIMEZONE=Asia/Bangkok
SNS_UPCOMING_CRON_ENABLED=true
CONTRACT_EXPIRING_CRON_ENABLED=true

# Tenant isolation — login email domain
# @shinasub.com → SNS devices (Owner = SNS)
# @tcc-technology.com → all devices that are not SNS
TENANT_SNS_EMAIL_DOMAIN=shinasub.com
TENANT_TCC_EMAIL_DOMAIN=tcc-technology.com

# Central login Usernames — hidden from Employee list (comma-separated, no passwords)
# Example: SYSTEM_USERNAMES=admin_sns,admin_tcc
SYSTEM_USERNAMES=

# Contract Merge (same SOF) — default ON in code when unset; set false|0|no to disable
ENABLE_CONTRACT_MERGE=true

